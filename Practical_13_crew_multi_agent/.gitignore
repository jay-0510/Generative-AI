# ---- Environment / secrets ----
.env
.env.local
*.env

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Linting / formatting caches ----
# Explicitly excluded per this project's requirements -- not needed in
# version control, regenerated automatically whenever ruff runs.
.ruff_cache/
.mypy_cache/
.pytest_cache/

# ---- CrewAI run history ----
# outputs/ holds a timestamped copy of every run (see src/main.py); these
# accumulate locally and don't need to be committed. The folder itself
# stays tracked via outputs/.gitkeep.
outputs/*.md
!outputs/.gitkeep

# NOTE: research_output.md (project root) is intentionally NOT ignored --
# it's the required "save output as markdown" deliverable for this
# practical.

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- IDE ----
.vscode/
.idea/
*.swp

# ---- Logs ----
*.log
